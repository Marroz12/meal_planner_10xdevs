---
import type { RecipeWithIngredients } from "@/lib/services/recipes";

interface Props {
  recipe: RecipeWithIngredients;
}

const { recipe } = Astro.props;

const ingredientCount = recipe.recipe_ingredients.length;
const prepTime = recipe.prep_time_minutes === null ? null : `${recipe.prep_time_minutes} min`;
const descriptionPreview = recipe.description
  ? recipe.description.length > 100
    ? `${recipe.description.slice(0, 100).trimEnd()}...`
    : recipe.description
  : "No description yet.";
---

<a
  href={`/recipes/${recipe.id}/edit`}
  class="group block rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl transition-transform transition-colors hover:-translate-y-1 hover:border-purple-300/40 hover:bg-white/15"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2
        class="bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-2xl font-semibold text-transparent"
      >
        {recipe.name}
      </h2>
      <p class="mt-3 text-sm leading-6 text-blue-100/70">{descriptionPreview}</p>
    </div>
    <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-medium text-blue-100/75">
      {ingredientCount} ingredient{ingredientCount === 1 ? "" : "s"}
    </span>
  </div>

  <div class="mt-6 flex items-center gap-3 text-sm text-blue-100/65">
    {
      prepTime && (
        <span class="rounded-full border border-white/10 bg-black/10 px-3 py-1">{prepTime}</span>
      )
    }
    <span class="text-purple-200/80 transition-colors group-hover:text-purple-100">Open recipe</span>
  </div>
</a>