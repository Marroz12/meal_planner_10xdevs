---
/* eslint-disable @typescript-eslint/no-misused-promises */
import RecipeForm from "@/components/recipes/RecipeForm";
import type { RecipeFormValues } from "@/components/recipes/RecipeForm";
import Topbar from "@/components/Topbar.astro";
import { getRecipe } from "@/lib/services/recipes";
import { createClient } from "@/lib/supabase";
import { recipeIdSchema } from "@/lib/validation/recipes";
import Layout from "@/layouts/Layout.astro";

let redirectTo: string | null = null;
let recipeId = "";

const user = Astro.locals.user;

if (!user) {
  redirectTo = "/auth/signin";
}

const parsedRecipeId = recipeIdSchema.safeParse({ id: Astro.params.id });
if (!parsedRecipeId.success && !redirectTo) {
  redirectTo = "/recipes";
}

if (parsedRecipeId.success) {
  recipeId = parsedRecipeId.data.id;
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let recipe = null;

if (!supabase && !redirectTo) {
  redirectTo = "/recipes";
}

if (!redirectTo && user && supabase && recipeId) {
  const { data } = await getRecipe(supabase, user.id, recipeId);
  recipe = data;
}

if (!recipe && !redirectTo) {
  redirectTo = "/recipes";
}

const initialValues: RecipeFormValues | null = recipe
  ? {
      name: recipe.name,
      description: recipe.description,
      prep_time_minutes: recipe.prep_time_minutes,
      ingredients: recipe.recipe_ingredients.map((ingredient) => ({
        name: ingredient.name,
        quantity: ingredient.quantity,
        unit: ingredient.unit,
        storage_type: ingredient.storage_type,
      })),
    }
  : null;
---

<Layout title="Edit Recipe">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"></div>
    <div class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"></div>
    <div class="pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-indigo-400/10 blur-[140px]"></div>

    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <div class="mx-auto mt-6 w-full max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <a href="/recipes" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Back to recipes
            </a>
            <h1 class="mt-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              Edit Recipe
            </h1>
            <p class="mt-2 text-sm text-blue-100/70">Update details and ingredients for this recipe.</p>
          </div>

          <button
            id="delete-recipe-button"
            type="button"
            class="inline-flex items-center justify-center rounded-lg border border-red-300/30 bg-red-500/10 px-4 py-2 text-sm font-medium text-red-100 transition-colors hover:bg-red-500/20"
          >
            Delete
          </button>
        </div>

        {
          initialValues ? (
            <RecipeForm client:load recipeId={recipeId} initialValues={initialValues} />
          ) : (
            <p class="text-sm text-blue-100/70">Redirecting...</p>
          )
        }
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ recipeId, recipeName: recipe?.name ?? "", redirectTo }}>
    if (redirectTo) {
      window.location.href = redirectTo;
    }

    const deleteButton = document.getElementById("delete-recipe-button");

    deleteButton?.addEventListener("click", async () => {
      const confirmed = window.confirm(`Delete "${recipeName}"? This cannot be undone.`);
      if (!confirmed) {
        return;
      }

      try {
        const response = await fetch(`/api/recipes/${recipeId}`, { method: "DELETE" });
        if (!response.ok) {
          window.alert("Could not delete this recipe. Please try again.");
          return;
        }

        window.location.href = "/recipes";
      } catch {
        window.alert("Network error. Please try again.");
      }
    });
  </script>
</Layout>